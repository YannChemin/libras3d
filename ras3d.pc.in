prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: ras3d
Description: Standalone GRASS raster3d replacement for hyperspectral GeoTIFF/HDF5
Version: @PROJECT_VERSION@
Cflags: -I${includedir} -DHAVE_RAS3D
Libs: -L${libdir} -lras3d
Libs.private: -lgeotiff -ltiff -lhdf5_serial -lm -fopenmp
